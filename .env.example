# B2H4 Content Hub - Configuração
# Copie para .env e preencha

# Supabase (mesmo da newsletter)
DATABASE_URL=postgresql://postgres.[project_ref]:***@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Resend (mesmo da newsletter)
RESEND_API_KEY=re_sua_key_aqui
FROM_EMAIL=content@b2h4.ai

# Telegram (mesmo da newsletter)
TELEGRAM_BOT_TOKEN=seu_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# Admin
ADMIN_KEY=1234

# Newsletter API (para send_to_newsletter via REST em produção)
NEWSLETTER_URL=https://b2h4-newsletter.onrender.com
NEWSLETTER_ADMIN_KEY=1234

# Flask
SECRET_KEY=gere-uma-chave-secreta
FLASK_PORT=5001

# ============================================================
# SEARCH ENGINES (opcionais — sem key = desativado)
# ============================================================

# Tavily (https://tavily.com — free tier: 1.000 calls/mês)
TAVILY_API_KEY=

# SearchAPI (https://www.searchapi.io — free tier: 100 calls)
SEARCHAPI_API_KEY=
